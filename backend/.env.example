# Copiar a .env y ajustar los valores.
# En local, si se omite DATABASE_URL se usa SQLite (inventario.db).
DATABASE_URL=sqlite:///./inventario.db

# En produccion (Render) pegar la cadena interna de PostgreSQL, por ejemplo:
# DATABASE_URL=postgresql://usuario:clave@dpg-xxxx-a.oregon-postgres.render.com:5432/inventario

# Origenes autorizados para CORS, separados por coma.
# Incluir el dominio real del frontend desplegado.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
